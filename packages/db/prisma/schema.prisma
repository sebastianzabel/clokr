// ─────────────────────────────────────────────
// SCHICHTPLANUNG
// ─────────────────────────────────────────────

model ShiftTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Frühschicht", "Spätschicht", "Nachtschicht"
  startTime String // "06:00"
  endTime   String // "14:00"
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now()) @db.Timestamptz

  shifts        Shift[]
  coverageRules CoverageRule[]
  shiftPatterns EmployeeShiftPattern[]

  @@index([tenantId])
}

// Phase 42 — Bedarfsregeln pro Vorlage × Wochentag.
// Most-specific match wins when computing coverage:
//   (templateId set AND dayOfWeek set) > (templateId null AND dayOfWeek set) >
//   (templateId set AND dayOfWeek=-1) > (templateId null AND dayOfWeek=-1)
// Default (no rule): minStaff=2.0, requiresNonSupervised=false.
model CoverageRule {
  id                    String         @id @default(uuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId            String?
  template              ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOfWeek             Int // 0=Mo..6=So; -1 = "all days"
  minStaff              Decimal        @default(2) @db.Decimal(4, 2)
  requiresNonSupervised Boolean        @default(false)
  createdAt             DateTime       @default(now()) @db.Timestamptz
  updatedAt             DateTime       @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@index([templateId])
}

model Shift {
  id                 String         @id @default(uuid())
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId         String?
  template           ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date               DateTime       @db.Date
  startTime          String // "06:00"
  endTime            String // "14:00"
  label              String? // Custom label or template name
  note               String?
  // Phase 43: marked TRUE by reverse-hook when a LeaveRequest is approved
  // that overlaps this shift's date. Audit-proof: shift is flagged, never silent-deleted.
  conflictsWithLeave Boolean        @default(false)
  createdAt          DateTime       @default(now()) @db.Timestamptz
  createdBy          String?
  // Phase 67.2 — Soft-Delete (additive only, audit-proof).
  // Set when an Auto-Cleanup-Hook removes a Shift on einem neu entstandenen Berufsschultag.
  // Vergangenheits-Shifts (date < today) werden NIE soft-deleted — nur conflictsWithLeave=true gesetzt.
  // Restore-Pfad via /shifts/conflicts UI mit explicit Manager-Aktion + AuditLog.
  deletedAt          DateTime?      @db.Timestamptz
  deletedReason      String? // z.B. "AUTO_BS_DAY_CLEANUP", "MANUAL_RESTORE_REVERT"

  @@index([employeeId, date])
  @@index([date])
  @@index([employeeId, date, deletedAt])
}

// Phase 43 — Recurring weekly shift assignments per employee.
// One row per (employee, dayOfWeek, validFrom): the active pattern is the one
// whose validFrom <= date AND (validUntil IS NULL OR validUntil >= date) AND isActive.
// templateId NULL = "leave the day open" (e.g. day off). With templateId = use this
// template on this weekday. POST /shifts/generate-week reads these and produces shifts.
model EmployeeShiftPattern {
  id         String         @id @default(uuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Mo..6=So
  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  validFrom  DateTime       @db.Date
  validUntil DateTime?      @db.Date // null = open-ended
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz

  @@unique([employeeId, dayOfWeek, validFrom])
  @@index([employeeId])
}

// Phase 62 — Recurring vocational-school day pattern per employee.
// Either daysOfWeek (regular weekdays) OR blockWeeks (ISO weeks of a year) must be set.
// Enforced application-side via Zod refine in routes/vocational-school-pattern.ts.
// The auto-generator (plugins/vocational-school-generator.ts) reads these and produces
// Absence rows of type VOCATIONAL_SCHOOL for the next TenantConfig.vocationalSchoolPreviewWeeks weeks.
//
// Phase 67.1 (v1.7.4) — Multi-day support: `daysOfWeek Int[]` replaces single-value
// `dayOfWeek Int?`. The legacy `dayOfWeek` column is retained for one release of soak
// (drop scheduled for v1.7.5) so downgrade is possible. New code MUST read/write
// `daysOfWeek`; the API normalises legacy inbound `dayOfWeek` into the array form.
model EmployeeVocationalSchoolPattern {
  id                    String        @id @default(uuid())
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek             Int? // DEPRECATED v1.7.4 — kept for one release of soak, drop in v1.7.5
  daysOfWeek            Int[]         @default([]) // 0=Mo..6=So for recurring weekdays; empty array when only blockWeeks set
  blockWeeks            Int[] // ISO week numbers for block-school weeks; empty array when only daysOfWeek set
  blockYear             Int? // Year context for blockWeeks (for annual uniqueness); null when only daysOfWeek set
  validFrom             DateTime      @db.Date
  validUntil            DateTime?     @db.Date // null = open-ended
  isActive              Boolean       @default(true)
  // Phase 67.2 — Schulferien-Integration. Default TRUE für IHK-Berufe (KMK-Ferien).
  // Opt-OUT für Pflegeschulen / Berufsakademien die eigenem Schuljahresplan folgen.
  respectSchoolHolidays Boolean       @default(true)
  // Phase 67.2 — Pendler-Azubi-Support: BS in anderem Bundesland als Betrieb.
  // NULL = verwende Tenant.federalState (Default).
  federalStateOverride  FederalState?
  // Phase 83 — per-pattern slot override (BBIG-V19-02; higher precedence than TenantConfig).
  // Same semantics as TenantConfig.bsSlot* — NULL means delegate to TenantConfig.
  bsSlotFirstLongDayMinutes   Int?
  bsSlotSecondLongDayMinutes  Int?
  bsSlotShortDayMinutes       Int?
  bsSlotBlockWeekMinutes      Int?
  createdAt             DateTime      @default(now()) @db.Timestamptz
  updatedAt             DateTime      @updatedAt @db.Timestamptz

  @@index([employeeId, isActive])
}

// Phase 46 — Employee availability declaration (recurring weekly OR one-off date).
// Resolution priority on GET /shifts/week: APPROVED LeaveRequest > non-deleted Absence >
// date-specific EmployeeAvailability > dayOfWeek-recurring EmployeeAvailability > AVAILABLE.
// XOR: EXACTLY ONE of dayOfWeek / date must be set (enforced in Zod app-layer).
// No deletedAt — operational future-intent data; audit-log records DELETE.
model EmployeeAvailability {
  id         String             @id @default(uuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int? // 0=Mo..6=So; null for one-off date entries
  date       DateTime?          @db.Date // null for recurring; set for one-off
  status     AvailabilityStatus
  note       String?            @db.VarChar(200)
  validFrom  DateTime           @db.Date
  validUntil DateTime?          @db.Date // null = open-ended
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz
  createdBy  String?

  @@index([employeeId])
  @@index([employeeId, dayOfWeek])
  @@index([employeeId, date])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}
