// ─────────────────────────────────────────────
// WORK EVENTS (v1.9 — generic day-event model)
// ─────────────────────────────────────────────
//
// Replaces Absence.type=VOCATIONAL_SCHOOL semantics with a dedicated table
// for "present-but-non-clocked" time (BS-Tag initial; FIELD_SERVICE / BUSINESS_TRIP /
// TRAINING / OTHER reserved for future types — adding them is a data-only change).
//
// Phase 63 D-01..D-04 invariant baked into the row:
//   - FIXED_SCHEDULE / SHIFT_BASED / FLEXTIME → workedMinutes == expectedMinutes (netto-neutral)
//   - MONTHLY_HOURS                            → workedMinutes only, expectedMinutes NULL
//
// Adapter: apps/api/src/utils/work-event.ts (Plan 02) — single read path for all saldo sites.
// Zod payload: apps/api/src/routes/work-events/payload-schema.ts (Plan 03).
// Endpoints:    apps/api/src/routes/work-events.ts (Plan 04 stubs → Phase 79 bodies).
// Migration:    apps/api/scripts/migrate-vocational-school-to-work-event.ts (Phase 80).
model WorkEvent {
  id              String          @id @default(uuid())
  employeeId      String
  type            WorkEventType
  source          WorkEventSource @default(MANUAL)
  date            DateTime        @db.Date
  // Resolved at write time (Phase 63 invariant becomes a property of the row,
  // not a recomputation per call site). Always set — never null.
  workedMinutes   Int
  // NULL for MONTHLY_HOURS schedule type (D-04: BS contributes to IST only,
  // never to Soll). Equal to workedMinutes for FIXED_SCHEDULE / SHIFT_BASED / FLEXTIME.
  expectedMinutes Int?
  // Discriminated-union payload — Zod validates per-type at API boundary (Plan 03).
  payload         Json?           @db.JsonB
  note            String?
  // Migration provenance — links back to the originating Absence.id when this row
  // was created by the Phase 80 migration script. Allows AuditLog joins across the
  // model boundary (PITFALLS.md M-2). Unique so re-running the migration is a no-op
  // for already-migrated rows.
  legacyAbsenceId String?         @unique
  // Audit + soft-delete (Revisionssicherheit) — identical convention to Absence.
  deletedAt       DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz
  createdBy       String?
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Idempotency at DB layer — mirrors Absence's @@unique([employeeId, startDate, type]).
  // P2002 on duplicate (employeeId, date, type) → caught by Phase 79 endpoints + Phase 80
  // migration script → returned as HTTP 409 or skipped-and-counted.
  @@unique([employeeId, date, type])
  @@index([employeeId, date])
  @@index([date])
  @@index([employeeId, type])
}

