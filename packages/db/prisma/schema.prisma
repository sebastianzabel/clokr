generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// MULTI-TENANT
// ─────────────────────────────────────────────

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  federalState FederalState @default(NIEDERSACHSEN)
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  employees            Employee[]
  leaveTypes           LeaveType[]
  publicHolidays       PublicHoliday[]
  config               TenantConfig?
  companyShutdowns     CompanyShutdown[]
  shiftTemplates       ShiftTemplate[]
  coverageRules        CoverageRule[]
  terminalApiKeys      TerminalApiKey[]
  apiKeys              ApiKey[]
  specialLeaveRules    SpecialLeaveRule[]
  presenceSources      PresenceSource[]
  presenceDevices      PresenceDevice[]
  // Phase 67.2 — Schulferien-Cache pro Tenant pro Bundesland
  schoolHolidayPeriods SchoolHolidayPeriod[]
  // Phase 85 — Phorest staff mapping + sync run history
  phorestStaffMappings PhorestStaffMapping[]
  phorestSyncRuns      PhorestSyncRun[]
}

// ─────────────────────────────────────────────
// MANDANTEN-KONFIGURATION (globale Arbeitszeitvorgaben)
// ─────────────────────────────────────────────

model TenantConfig {
  id                                  String  @id @default(uuid())
  tenantId                            String  @unique
  // Standard-Wochenstunden (Vorlage für neue Mitarbeiter)
  defaultWeeklyHours                  Decimal @default(40) @db.Decimal(5, 2)
  defaultMondayHours                  Decimal @default(8) @db.Decimal(4, 2)
  defaultTuesdayHours                 Decimal @default(8) @db.Decimal(4, 2)
  defaultWednesdayHours               Decimal @default(8) @db.Decimal(4, 2)
  defaultThursdayHours                Decimal @default(8) @db.Decimal(4, 2)
  defaultFridayHours                  Decimal @default(8) @db.Decimal(4, 2)
  defaultSaturdayHours                Decimal @default(0) @db.Decimal(4, 2)
  defaultSundayHours                  Decimal @default(0) @db.Decimal(4, 2)
  // Überstunden
  overtimeThreshold                   Decimal @default(60) @db.Decimal(5, 2)
  allowOvertimePayout                 Boolean @default(false)
  // Urlaubsanspruch (Basis 5-Tage-Woche)
  defaultVacationDays                 Decimal @default(30) @db.Decimal(5, 2)
  // Resturlaub-Verfall: Tag und Monat im Folgejahr (z.B. 31. März = day=31, month=3)
  carryOverDeadlineDay                Int     @default(31)
  carryOverDeadlineMonth              Int     @default(3)
  // E-Mail / SMTP
  smtpHost                            String?
  smtpPort                            Int?
  smtpUser                            String?
  smtpPassword                        String?
  smtpFromEmail                       String?
  smtpFromName                        String?
  smtpSecure                          Boolean @default(false)
  // Sicherheit
  twoFaEnabled                        Boolean @default(false)
  // Passwort-Richtlinie (BSI TR-02102-1)
  passwordMinLength                   Int     @default(12)
  passwordRequireUpper                Boolean @default(true)
  passwordRequireLower                Boolean @default(true)
  passwordRequireDigit                Boolean @default(true)
  passwordRequireSpecial              Boolean @default(true)
  // Session-Management
  sessionTimeoutMinutes               Int     @default(60) // Inaktivitäts-Timeout (0 = deaktiviert)
  refreshTokenDays                    Int     @default(7) // Refresh Token Laufzeit in Tagen
  rememberMeEnabled                   Boolean @default(true) // "Angemeldet bleiben" Checkbox
  rememberMeDays                      Int     @default(30) // Refresh Token bei "Remember me"
  maxSessionsPerUser                  Int     @default(0) // Max gleichzeitige Sessions (0 = unbegrenzt)
  // Zeitzone (IANA)
  timezone                            String  @default("Europe/Berlin")
  // Phorest-Integration
  phorestBusinessId                   String?
  phorestBranchId                     String?
  phorestUsername                     String?
  phorestPassword                     String?
  phorestBaseUrl                      String? @default("https://api-gateway-eu.phorest.com/third-party-api-server")
  phorestAutoSync                     Boolean @default(false)
  phorestSyncCron                     String  @default("0 3 * * *") // Default: täglich 03:00
  // Phase 85 (SS-06): configurable sync window in days ahead of today. Default 7 matches the previously
  // hard-coded 7-day window in scheduler.ts — migration-neutral for existing tenants.
  phorestSyncWindowDays               Int     @default(7)
  // Phase 85.1 (D-01): Vorbereitungszeit in minutes, tenant-global, 0-30
  phorestPrepMinutes                  Int     @default(0)
  // Phase 85.1 (D-01): Nachbereitungszeit in minutes, tenant-global, 0-30
  phorestWrapupMinutes                Int     @default(0)
  // Phase 86 (SA-03): configurable forward window in days for the appointment cache (today .. today+horizon).
  // Distinct from phorestSyncWindowDays (shifts) — appointments look further ahead (leave is requested months out).
  phorestAppointmentHorizonDays       Int     @default(90)
  // Compliance
  arbzgEnabled                        Boolean @default(true) // ArbZG-Verstöße anzeigen
  // Verfügbarkeits-System (Phase 47.3) — when false, EmployeeAvailability is ignored by the resolver,
  // auto-gen/copy-week do NOT skip UNAVAILABLE, and GET/PUT availability endpoints return 410 Gone.
  // Data preserved (rows remain), feature toggleable at any time.
  availabilityEnabled                 Boolean @default(true)
  // Phase 67.2 — Globaler Opt-Out für Auto-Cleanup von Shifts auf neuen BS-Tagen.
  // FALSE = nur Konflikt-Badge setzen (heutiges Verhalten), keine Soft-Delete.
  // TRUE = Auto-Soft-Delete für `date >= today + 1d` Shifts + Audit + Notification.
  vocationalSchoolAutoCleanupShifts   Boolean @default(true)
  // Heiligabend / Silvester: NORMAL | HALF_DAY | FULL_DAY_OFF
  christmasEveRule                    String  @default("NORMAL")
  newYearsEveRule                     String  @default("NORMAL")
  holidayRulesValidFromYear           Int? // Rules apply from this year onwards (null = current year when saved)
  // Abwesenheits-Konfiguration
  vacationLeadTimeDays                Int     @default(0) // Min. Tage im Voraus für Urlaubsanträge (0 = keine)
  vacationMaxAdvanceMonths            Int     @default(0) // Max. Monate im Voraus für Urlaub (0 = unbegrenzt)
  // Phase 62 — Berufsschultag-Auto-Generator: rolling preview window (weeks ahead)
  vocationalSchoolPreviewWeeks        Int     @default(13) // Rolling window (weeks ahead) the cron generator pre-populates — v1.7.4 bumped 4→13 so the window spans typical Schulferien gaps
  // Phase 63 — Berufsschule Saldo/ArbZG (D-02): per-tenant configurable BS-day duration
  vocationalSchoolMinutesPerDay       Int     @default(480) // Net Anrechnung per single BS-day (default 8h = 480 min, BERSCH-03)
  vocationalSchoolBlockMinutesPerWeek Int     @default(2400) // Total Anrechnung per block-week (default 40h = 2400 min, BERSCH-04)
  // Phase 76.31 — BVaDiG-2024 slot-aware BS crediting (D-06 tenant-level layer).
  // NULL = fall through to vocationalSchoolMinutesPerDay / daily-Soll fallback.
  bsSlotFirstLongDayMinutes           Int?
  bsSlotSecondLongDayMinutes          Int?
  bsSlotShortDayMinutes               Int?
  bsSlotBlockWeekMinutes              Int?
  halfDayAllowed                      Boolean @default(true) // Halbe Tage erlaubt
  sickSelfReport                      Boolean @default(true) // MA dürfen Krankmeldung selbst eintragen
  sickNoteRequiredAfterDays           Int     @default(3) // AU-Pflicht nach X Krankheitstagen
  // Teilzeit-Urlaub
  autoCalcPartTimeVacation            Boolean @default(true) // Automatische Pro-Rata Berechnung
  fullTimeWorkDaysPerWeek             Int     @default(5) // Referenz für Vollzeit (5 oder 6)
  // Phase 49.4 — Tenant-Default Arbeitstage/Woche, unabhängig vom AZ-Modell.
  // Quelle der Wahrheit für Urlaubsverbrauch und Pro-Rata-Berechnung.
  // Format: Array aus Wochentag-Nummern (0=So, 1=Mo, …, 6=Sa). Default: Mo-Fr.
  defaultWorkDays                     Int[]   @default([1, 2, 3, 4, 5])
  // Carry-Over / Mindesturlaub (§ 3 + § 7 BUrlG)
  enforceMinVacation                  Boolean @default(true) // Warn when statutory minimum not taken
  carryOverRequiresReason             Boolean @default(true) // Carry-over beyond allowed needs documented reason
  vacationReminderStartMonth          Int     @default(10) // Month to start vacation expiry reminders (1-12)
  // BUrlG § 7 Hinweispflicht (EuGH C-684/16) — threshold-based carry-over warnings
  carryoverWarningEnabled             Boolean @default(true) // Master switch for daily warning cron
  carryoverWarningThresholds          Int[]   @default([60, 30, 14, 7]) // Days before deadline at which to issue a warning

  // E-Mail-Benachrichtigungen
  emailNotificationsEnabled         Boolean  @default(false) // Master switch
  emailOnLeaveRequest               Boolean  @default(true) // Neuer Urlaubsantrag
  emailOnLeaveDecision              Boolean  @default(true) // Urlaub genehmigt/abgelehnt
  emailOnOvertimeWarning            Boolean  @default(false) // Überstunden-Schwellwert
  emailOnMissingEntries             Boolean  @default(false) // Fehlende Zeiteinträge
  emailOnClockOutReminder           Boolean  @default(false) // Vergessene Stempelung
  emailOnMonthClose                 Boolean  @default(true) // Monatsabschluss
  // Automatische Erinnerungen
  reminderPendingLeaveHours         Int      @default(48) // Manager erinnern nach X Stunden ohne Reaktion
  reminderUpcomingAbsenceDays       Int      @default(3) // MA erinnern X Tage vor Abwesenheit
  reminderPendingLeaveEnabled       Boolean  @default(true)
  reminderUpcomingAbsenceEnabled    Boolean  @default(true)
  // Benachrichtigungen
  clockOutReminderHours             Int      @default(10) // Stunden nach denen an offene Stempelung erinnert wird
  missingEntriesDays                Int      @default(7) // Tage ohne Einträge bevor erinnert wird
  autoDeleteOpenHours               Int      @default(14) // LEGACY NAME: Stunden nach denen offene Einträge auto-INVALIDIERT werden (nicht gelöscht!), 0 = deaktiviert
  // Pausen-Slots
  autoBreakEnabled                  Boolean  @default(false)
  defaultBreakStart                 String?  @db.VarChar(5) // e.g. "12:00"
  // Phase 64 — Pausendauer (D-01, BREAK-01, BREAK-08): per-tenant default break durations.
  // Defaults 30/45 match the previously hard-coded auto-break behavior — Migration neutral.
  // ArbZG-Floor is HARD-CODED in apps/api/src/utils/break-constants.ts (NOT here) — these are defaults, not the legal minimum.
  defaultBreakOver6h                Int      @default(30) // Pausen-Minuten ab > 6h Arbeitszeit (ArbZG §4 Minimum 30, vertraglich erhöhbar)
  defaultBreakOver9h                Int      @default(45) // Pausen-Minuten ab > 9h Arbeitszeit (ArbZG §4 Minimum 45, vertraglich erhöhbar)
  // Phase 91/92 (BREAK-05) — Break-Confirmation enforcement (consumed from Phase 92).
  enforceBreakConfirmation          Boolean  @default(false)
  blockMonthCloseOnUnconfirmedBreak Boolean  @default(false)
  // Phase 76.2 (ARCH-V19-01, D-04) — Cross-source same-day consolidation gap (NFC/MOBILE/WIFI). Default 4h widens 76.1's NFC-only 2h to all sources.
  consolidationGapHours             Int      @default(4)
  // Überstunden-Jahresübertrag
  overtimeCarryOverMode             String   @default("FULL") // FULL | CAPPED | RESET
  overtimeCarryOverCap              Int? // Max. Übertrag in Minuten (nur bei CAPPED)
  // Max. Minusstunden (null = unbegrenzt, Wert in Minuten)
  maxNegativeBalanceMinutes         Int?
  // Account-Lockout
  loginMaxAttempts                  Int      @default(5) // Fehlversuche bis Sperre
  loginLockoutMinutes               Int      @default(15) // Sperrzeit in Minuten
  // Aufbewahrungsfrist in Jahren (Minimum 2, Default 10)
  dataRetentionYears                Int      @default(10)
  // MONTHLY_HOURS: Feiertage reduzieren Monatsstunden-Soll
  monthlyHoursHolidayDeduction      Boolean  @default(false)
  // DATEV Lohnartennummern (konfigurierbar pro Mandant, Phase 4)
  datevNormalstundenNr              Int      @default(100)
  datevUrlaubNr                     Int      @default(300)
  datevKrankNr                      Int      @default(200)
  datevSonderurlaubNr               Int      @default(302)
  // FLEXTIME Kernarbeitszeit-Defaults (Phase 49.2) — pre-fill suggestion for new FLEXTIME employees
  defaultCoreStart                  String?  @db.VarChar(5) // HH:MM, optional tenant default
  defaultCoreEnd                    String?  @db.VarChar(5) // HH:MM, optional tenant default
  defaultCoreDays                   Int[]    @default([]) // 0=Sun..6=Sat day-of-week (same encoding as WorkSchedule.coreDays)
  // WiFi-Presence
  wifiPresenceWindowMinutes         Int      @default(15) // Shift-window gate: ±N minutes around shift start/end
  // Ladenöffnungszeiten (Phase 42) — JSON array, one entry per weekday.
  // Shape: Array<{ day: 0..6 (Mo..So), open: "HH:MM", close: "HH:MM", closed?: boolean }>
  // Default: Mo-Sa 08:00-20:00, So closed
  storeHours                        Json     @default("[{\"day\":0,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":1,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":2,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":3,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":4,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":5,\"open\":\"08:00\",\"close\":\"20:00\"},{\"day\":6,\"open\":\"08:00\",\"close\":\"20:00\",\"closed\":true}]")
  // Phase 47.5 — How tightly to bind shifts to store hours.
  //   DAY_ONLY (default): block only on closed days (lets MAs prep before / clean after)
  //   STRICT:             shift time must be within [open, close]
  //   OFF:                no store-hours check
  shiftStoreHoursMode               String   @default("DAY_ONLY")
  // Phase 76.29 CFG-01 — retro self-service window (days back from today an employee may submit a retro request)
  retroEntryWindowDays              Int      @default(10)
  // Phase 76.29 CFG-01 — allows cron/manual month-close to proceed when open gaps exist (gap-warning only, not blocking)
  closeMonthWithGapsAllowed         Boolean  @default(true)
  createdAt                         DateTime @default(now()) @db.Timestamptz
  updatedAt                         DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                Role      @default(EMPLOYEE)
  isActive            Boolean   @default(true)
  emailNotifications  Boolean   @default(true) // Per-user email opt-out
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
  uiPreferences       Json?     @db.JsonB
  lastFailedLoginAt   DateTime? @db.Timestamptz
  lastLoginAt         DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  employee      Employee?
  refreshTokens RefreshToken[]
  otpTokens     OtpToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpToken {
  id        String    @id @default(uuid())
  userId    String
  code      String // 6-stellig, bcrypt-gehasht
  expiresAt DateTime  @db.Timestamptz // now + 10 min
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id         String    @id @default(uuid())
  token      String    @unique
  employeeId String
  email      String
  expiresAt  DateTime  @db.Timestamptz
  acceptedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// MITARBEITER
// ─────────────────────────────────────────────

model Employee {
  id                           String                 @id @default(uuid())
  tenantId                     String
  userId                       String                 @unique
  employeeNumber               String
  firstName                    String
  lastName                     String
  nfcCardId                    String?                @unique // NFC Karten-ID
  wifiMacs                     String[]               @default([]) // normalized "aa:bb:cc:dd:ee:ff", multiple devices per employee
  wifiPresenceEnabled          Boolean                @default(false) // GDPR opt-in required — false until employee explicitly opts in
  wifiOptInAt                  DateTime?              @db.Timestamptz // timestamp when employee opted in (null = not opted in)
  avatarPath                   String? // Path in MinIO (e.g. avatars/{tenantId}/{id}.webp)
  // Personalstruktur (Phase 41): classification + Coverage-Gewicht + Aufsichtspflicht
  classification               EmployeeClassification @default(VOLLZEIT)
  coverageWeight               Decimal                @default(1.00) @db.Decimal(3, 2)
  requiresSupervision          Boolean                @default(false)
  hireDate                     DateTime               @db.Timestamptz
  exitDate                     DateTime?              @db.Timestamptz
  // Phase 63 (D-10): Geburtsdatum für JArbSchG §9 Altersprüfung (AZUBI < 18).
  // Nullable: fail-open — wenn nicht gesetzt, wird der Hard-Block NICHT ausgelöst (siehe checkJArbSchG).
  birthDate                    DateTime?              @db.Date
  // Phase 64 — Pausendauer Override (D-02, BREAK-02): nullable = fall back to TenantConfig defaults.
  // Server-side validation rejects values below ArbZG-Floor (30/45) — see apps/api/src/routes/employees.ts Zod schema.
  breakOver6hOverride          Int? // null = TenantConfig.defaultBreakOver6h verwenden
  breakOver9hOverride          Int? // null = TenantConfig.defaultBreakOver9h verwenden
  // Phase 85.1.1 (D-01) — per-employee Phorest Vor-/Nachbereitungszeit override.
  // null = fall back to TenantConfig.phorestPrepMinutes/phorestWrapupMinutes; 0 = explicit "no puffer".
  phorestPrepMinutesOverride   Int? // null = TenantConfig.phorestPrepMinutes verwenden (0-30 wenn gesetzt)
  phorestWrapupMinutesOverride Int? // null = TenantConfig.phorestWrapupMinutes verwenden (0-30 wenn gesetzt)
  // Phase 76.31 — BVaDiG-2024 slot-aware BS crediting (D-06 per-employee override layer).
  // NULL = delegate to EmployeeVocationalSchoolPattern.
  bsSlotFirstLongDayMinutes    Int?
  bsSlotSecondLongDayMinutes   Int?
  bsSlotShortDayMinutes        Int?
  bsSlotBlockWeekMinutes       Int?
  // Phase 76.7 (D-01, EMP-V19-01) — § 18 ArbZG-Befreiung für Inhaber/Geschäftsführer/leitende
  // Angestellte. Wenn true: SKIP updateOvertimeAccount + checkArbZG + recalculateSnapshots
  // + close-month* + open-items missing-dates. BUrlG (Urlaub) bleibt aktiv. Toggle nur
  // durch ADMIN; AuditLog action SET_TIME_TRACKING_EXEMPT (siehe Plan 02).
  isTimeTrackingExempt         Boolean                @default(false)
  createdAt                    DateTime               @default(now()) @db.Timestamptz
  updatedAt                    DateTime               @updatedAt @db.Timestamptz

  tenant                   Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                     User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSchedules            WorkSchedule[]
  overtimeAccount          OvertimeAccount?
  saldoSnapshots           SaldoSnapshot[]
  // Phase 99 — onDelete: Restrict, mirrors saldoSnapshots (never cascade-delete saldo history)
  openingBalances          OpeningBalance[]
  timeEntries              TimeEntry[]
  leaveEntitlements        LeaveEntitlement[]
  leaveRequests            LeaveRequest[]
  absences                 Absence[]
  overtimePlans            OvertimePlan[]
  invitations              Invitation[]
  shutdownExceptions       CompanyShutdownException[]
  shifts                   Shift[]
  shiftPatterns            EmployeeShiftPattern[]
  vocationalSchoolPatterns EmployeeVocationalSchoolPattern[]
  availabilities           EmployeeAvailability[]
  presenceDevices          PresenceDevice[]
  retroEntryRequests       RetroEntryRequest[]
  // Phase 85 — explicit Phorest staff mapping (onDelete: Restrict — never cascade-delete history)
  phorestStaffMappings     PhorestStaffMapping[]
  // Phase 86 — DSGVO-minimal appointment busy-window cache (onDelete: Restrict — never cascade-delete)
  phorestAppointments      PhorestAppointment[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// ARBEITSZEITMODELL
// ─────────────────────────────────────────────

model WorkSchedule {
  id                        String       @id @default(uuid())
  employeeId                String
  type                      ScheduleType @default(FIXED_SCHEDULE)
  weeklyHours               Decimal?     @db.Decimal(5, 2) // null erlaubt; SHIFT_BASED + FLEXTIME nutzen es als Wochen-Soll, FIXED_SCHEDULE als Σ aus per-day, MONTHLY_HOURS null
  monthlyHours              Decimal?     @db.Decimal(5, 2) // z.B. 15.00 für Minijobber
  mondayHours               Decimal      @default(8) @db.Decimal(4, 2)
  tuesdayHours              Decimal      @default(8) @db.Decimal(4, 2)
  wednesdayHours            Decimal      @default(8) @db.Decimal(4, 2)
  thursdayHours             Decimal      @default(8) @db.Decimal(4, 2)
  fridayHours               Decimal      @default(8) @db.Decimal(4, 2)
  saturdayHours             Decimal      @default(0) @db.Decimal(4, 2)
  sundayHours               Decimal      @default(0) @db.Decimal(4, 2)
  // Phase 49.4 — Arbeitstage/Woche, unabhängig vom AZ-Modell.
  // Quelle der Wahrheit für Urlaubsverbrauch (calculateWorkDays) und
  // Pro-Rata-Berechnung (countWorkDaysPerWeek). Befüllt aus TenantConfig.defaultWorkDays
  // beim Anlegen neuer Mitarbeiter; pro MA überschreibbar via /admin/vacation.
  // Format: Array aus Wochentag-Nummern (0=So, 1=Mo, …, 6=Sa). Default: Mo-Fr.
  workDays                  Int[]        @default([1, 2, 3, 4, 5])
  // Phase 49.1 — FLEXTIME Kernarbeitszeit (optional; UI metadata only — does not affect calcExpectedMinutesTz)
  coreStart                 String? // HH:MM, FLEXTIME only
  coreEnd                   String? // HH:MM, FLEXTIME only
  coreDays                  Int[]        @default([]) // 0=Sun..6=Sat day-of-week, FLEXTIME only
  overtimeThreshold         Decimal      @default(60) @db.Decimal(5, 2) // Alert ab X Stunden
  allowOvertimePayout       Boolean      @default(false)
  overtimeMode              String       @default("CARRY_FORWARD") // "CARRY_FORWARD" | "TRACK_ONLY"
  maxNegativeBalanceMinutes Int? // Pro-MA Override (null = Tenant-Default)
  validFrom                 DateTime     @db.Timestamptz
  createdAt                 DateTime     @default(now()) @db.Timestamptz
  updatedAt                 DateTime     @updatedAt @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, validFrom])
}

// ─────────────────────────────────────────────
// ZEITERFASSUNG
// ─────────────────────────────────────────────

// Partial index (hand-authored in migration — Prisma cannot express WHERE):
// CREATE INDEX "TimeEntry_employeeId_open_idx" ON "TimeEntry"("employeeId") WHERE "endTime" IS NULL
model TimeEntry {
  id            String          @id @default(uuid())
  employeeId    String
  date          DateTime        @db.Date
  startTime     DateTime        @db.Timestamptz
  endTime       DateTime?       @db.Timestamptz
  breakMinutes  Int             @default(0)
  type          TimeEntryType   @default(WORK)
  source        TimeEntrySource @default(MANUAL)
  note          String?
  isLocked      Boolean         @default(false) // nach Monatsabschluss gesperrt
  lockedAt      DateTime?       @db.Timestamptz
  isInvalid     Boolean         @default(false) // automatisch invalidiert (z.B. kein Ausstempeln)
  invalidReason String? // Grund der Invalidierung
  deletedAt     DateTime?       @db.Timestamptz // soft delete
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz
  createdBy     String? // userId wer es angelegt hat

  breakStatus       BreakStatus @default(CONFIRMED) // Phase 91 (BREAK-01)
  breakWaivedReason String? // Phase 91 (BREAK-03)

  retroRequestId String? @unique // Phase 96 (RETRO-18) — 1:1 coupling to the Nachtrag request

  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  breaks       Break[]
  retroRequest RetroEntryRequest? @relation(fields: [retroRequestId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date], map: "TimeEntry_employeeId_date_unique_not_deleted")
  @@index([date])
}

model Break {
  id          String   @id @default(uuid())
  timeEntryId String
  startTime   DateTime @db.Timestamptz
  endTime     DateTime @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
}

// ─────────────────────────────────────────────
// SALDO-SNAPSHOTS (Monatsabschluss / Jahresübertrag)
// ─────────────────────────────────────────────

model SaldoSnapshot {
  id               String          @id @default(uuid())
  employeeId       String
  periodType       SaldoPeriodType
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  workedMinutes    Int // Ist-Arbeitszeit im Zeitraum
  expectedMinutes  Int // Soll-Arbeitszeit im Zeitraum
  balanceMinutes   Int // Differenz (worked - expected)
  carryOver        Int // Kumulierter Übertrag bis periodEnd
  closedAt         DateTime        @db.Timestamptz
  closedBy         String? // userId wer abgeschlossen hat (null = SYSTEM)
  note             String?
  // Phase 76.6 — TZ-duplicate cleanup. `superseded` rows are excluded from
  // production findFirst/findMany via `where: { superseded: false }`. Never
  // hard-deleted (Revisionssicherheit). See .planning/phases/76.6-*/76.6-NOTES.md.
  superseded       Boolean         @default(false)
  supersededReason String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Uniqueness enforced by partial unique index in migration (COMP-V1814-04):
  //   CREATE UNIQUE INDEX "SaldoSnapshot_active_unique"
  //     ON "SaldoSnapshot" ("employeeId", "periodType", "periodStart")
  //     WHERE "superseded" = false;
  // Only one active (superseded=false) row per employee+periodType+periodStart is allowed.
  // Superseded rows (superseded=true) are preserved for Revisionssicherheit.
  @@index([employeeId])
  @@index([employeeId, periodType])
}

enum SaldoPeriodType {
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────────
// ERÖFFNUNGSSALDO (übernommene Alt-Überstunden)
// ─────────────────────────────────────────────

// Phase 99 (OB-01). Provenance of the value, for a Betriebsprüfer:
//   MIGRATED_FROM_SNAPSHOT — moved off an existing SaldoSnapshot.carryOver injection,
//                            provenance recovered from AuditLog.
//   RECONSTRUCTED          — the value is real but its original justification could not be
//                            recovered from AuditLog; the row is honestly marked incomplete.
//   ADMIN_ENTRY            — entered through the ADMIN endpoint (POST /overtime/opening-balance).
enum OpeningBalanceSource {
  MIGRATED_FROM_SNAPSHOT
  RECONSTRUCTED
  ADMIN_ENTRY
}

model OpeningBalance {
  id            String               @id @default(uuid())
  employeeId    String
  minutes       Int // signed: positive = übernommenes Guthaben, negativ = übernommene Minusstunden
  effectiveFrom DateTime             @db.Date // Stichtag, ab dem der Wert gilt (i. d. R. Tracking-Beginn)
  reason        String // Freitext-Begründung (Revisionssicherheit — Pflichtfeld)
  evidenceRef   String? // Beleg-Referenz (Ticket, Dokument, Altsystem-Export)
  source        OpeningBalanceSource
  createdBy     String // userId (SYSTEM-Migrationen setzen die Actor-Id des Operators)
  approvedBy    String? // Phase 99: befüllt, aber NICHT erzwungen (Ein-Admin-Deployment)
  approvedAt    DateTime?            @db.Timestamptz
  createdAt     DateTime             @default(now()) @db.Timestamptz

  // Korrekturen superseden + neu anlegen, niemals in-place editieren (Revisionssicherheit).
  superseded       Boolean @default(false)
  supersededReason String?
  supersededBy     String? // id der Nachfolge-Zeile

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Uniqueness enforced by a PARTIAL unique index in the migration (Prisma's DSL cannot
  // express a WHERE clause — same asymmetry as SaldoSnapshot above, deliberately):
  //   CREATE UNIQUE INDEX "OpeningBalance_active_unique"
  //     ON "OpeningBalance" ("employeeId")
  //     WHERE "superseded" = false;
  // At most ONE active (superseded=false) row per employee. Superseded rows are preserved
  // forever (Revisionssicherheit, retention §147 AO — see anonymize.ts preserve-list).
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// ÜBERSTUNDENKONTO
// ─────────────────────────────────────────────

model OvertimeAccount {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  balanceHours Decimal  @default(0) @db.Decimal(7, 2) // aktueller Saldo
  updatedAt    DateTime @updatedAt @db.Timestamptz

  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  transactions OvertimeTransaction[]
}

model OvertimeTransaction {
  id                String                  @id @default(uuid())
  overtimeAccountId String
  hours             Decimal                 @db.Decimal(7, 2) // positiv = Überstunden, negativ = Abbau
  type              OvertimeTransactionType
  description       String?
  referenceMonth    String? // "2024-03" für Monatsabschluss
  createdAt         DateTime                @default(now()) @db.Timestamptz
  createdBy         String?

  overtimeAccount OvertimeAccount @relation(fields: [overtimeAccountId], references: [id], onDelete: Cascade)

  @@index([overtimeAccountId])
}

model OvertimePlan {
  id            String             @id @default(uuid())
  employeeId    String
  hoursToReduce Decimal            @db.Decimal(7, 2)
  deadline      DateTime           @db.Timestamptz
  status        OvertimePlanStatus @default(ACTIVE)
  note          String?
  createdAt     DateTime           @default(now()) @db.Timestamptz
  createdBy     String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─────────────────────────────────────────────
// URLAUB
// ─────────────────────────────────────────────

model LeaveType {
  id               String   @id @default(uuid())
  tenantId         String
  name             String // "Urlaub", "Sonderurlaub", etc.
  isPaid           Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  color            String   @default("#3B82F6")
  allowHalfDay     Boolean  @default(true) // Can this type be requested as half-day?
  maxDaysPerYear   Int? // Optional annual limit per employee
  leadTimeDays     Int? // Per-type override for lead time (null = use global)
  createdAt        DateTime @default(now()) @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LeaveEntitlement {
  id                String    @id @default(uuid())
  employeeId        String
  leaveTypeId       String
  year              Int
  totalDays         Decimal   @db.Decimal(5, 2)
  usedDays          Decimal   @default(0) @db.Decimal(5, 2)
  carriedOverDays   Decimal   @default(0) @db.Decimal(5, 2) // Resturlaub Vorjahr
  carryOverDeadline DateTime? @db.Timestamptz // bis wann Resturlaub genommen werden muss
  carryOverReason   String? // ILLNESS | OPERATIONAL | OTHER (null = automatic)
  carryOverNote     String? // Freitext-Begründung für Übertrag
  isAutoCalculated  Boolean   @default(false) // Was this entitlement auto-calculated for part-time?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model SpecialLeaveRule {
  id            String   @id @default(uuid())
  tenantId      String
  name          String // e.g. "Hochzeit", "Geburt eines Kindes"
  reason        String? // Description / display text
  defaultDays   Decimal  @default(1) @db.Decimal(4, 2) // Default entitlement days
  isStatutory   Boolean  @default(false) // § 616 BGB (cannot be deleted, only deactivated)
  requiresProof Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LeaveRequest {
  id                      String             @id @default(uuid())
  employeeId              String
  leaveTypeId             String
  specialLeaveRuleId      String? // For SPECIAL type: which rule applies
  startDate               DateTime           @db.Date
  endDate                 DateTime           @db.Date
  days                    Decimal            @db.Decimal(5, 2)
  halfDay                 Boolean            @default(false)
  status                  LeaveRequestStatus @default(PENDING)
  note                    String?
  reviewedBy              String?
  reviewedAt              DateTime?          @db.Timestamptz
  reviewNote              String?
  cancellationRequestedBy String? // userId who requested cancellation (for 4-eyes COMP-V1814-02)
  // Attest (nur für SICK / SICK_CHILD)
  attestPresent           Boolean            @default(false)
  attestValidFrom         DateTime?          @db.Date
  attestValidTo           DateTime?          @db.Date
  deletedAt               DateTime?          @db.Timestamptz // soft delete
  createdAt               DateTime           @default(now()) @db.Timestamptz
  updatedAt               DateTime           @updatedAt @db.Timestamptz

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  specialLeaveRule SpecialLeaveRule? @relation(fields: [specialLeaveRuleId], references: [id])

  @@index([employeeId])
  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────
// RETRO-EINTRAG-ANFRAGEN (Phase 76.29)
// ─────────────────────────────────────────────

model RetroEntryRequest {
  id         String           @id @default(uuid())
  employeeId String
  targetDate DateTime         @db.Date // the entry date the grant covers
  reason     String // mandatory (Revisionssicherheit)
  // Proposed worked times so the approver can review them before granting.
  // Nullable/additive: pre-existing rows backfill to null (no data migration).
  startTime    String? // "HH:MM" — proposed work start (mirrors TimeEntry.startTime style)
  endTime      String? // "HH:MM" — proposed work end
  breakMinutes Int? // proposed total break minutes (optional)
  status     RetroEntryStatus @default(PENDING)
  reviewedBy String? // approver userId
  reviewedAt DateTime?        @db.Timestamptz
  reviewNote String? // mandatory on approve/reject (enforced at route Zod, not DB)
  deletedAt  DateTime?        @db.Timestamptz // soft-delete convention
  createdAt  DateTime         @default(now()) @db.Timestamptz
  updatedAt  DateTime         @updatedAt @db.Timestamptz

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeEntry TimeEntry? // Phase 96 (RETRO-18) — back-relation, no column here; TimeEntry owns the FK

  @@index([employeeId])
  @@index([employeeId, targetDate])
  @@index([employeeId, status])
}

// ─────────────────────────────────────────────
// ABWESENHEITEN
// ─────────────────────────────────────────────

model Absence {
  id                 String        @id @default(uuid())
  employeeId         String
  type               AbsenceType
  source             AbsenceSource @default(MANUAL) // Phase 63 (D-22): PATTERN = auto-generated, MANUAL = human-created. Pre-v1.7 rows backfill to MANUAL (safe per RESEARCH A2).
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  days               Decimal       @db.Decimal(5, 2)
  halfDay            Boolean       @default(false)
  note               String?
  documentPath       String? // Pfad zur AU-Bescheinigung (MinIO)
  deletedAt          DateTime?     @db.Timestamptz // soft delete
  createdAt          DateTime      @default(now()) @db.Timestamptz
  createdBy          String
  // Phase 76.38 — Per-day Unterrichtszeit override for duration-based BS slot classification.
  // NULL = use pattern value (EmployeeVocationalSchoolPattern.unterrichtsMinutenByDow) or ordinal fallback.
  // Set by admin when a specific BS day deviates from the Jahrgang Stundenplan.
  // Only relevant for Absence.type = VOCATIONAL_SCHOOL; ignored for all other types.
  unterrichtsMinutes Int?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, startDate, type]) // Phase 63 (Pitfall #5): DB-level idempotency for D-23 manual-insert race
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// FEIERTAGE
// ─────────────────────────────────────────────

model PublicHoliday {
  id           String       @id @default(uuid())
  tenantId     String
  date         DateTime     @db.Date
  name         String
  federalState FederalState
  year         Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, year])
}

// ─────────────────────────────────────────────
// SCHULFERIEN (Phase 67.2)
// ─────────────────────────────────────────────

// Phase 67.2 — Schulferien-Cache pro Tenant pro Bundesland.
// Quelle primär: OpenHolidays API; sekundär MANUAL (ICS-Upload / Admin-Seed).
// Per-Tenant Cache (NICHT global) — Multi-Tenancy-Audit-Anforderung, siehe RESEARCH §192.
// Trennung von PublicHoliday: Schulferien sind Date-RANGES, Feiertage 1-Tag. Andere Quelle, andere Semantik.
model SchoolHolidayPeriod {
  id           String       @id @default(uuid())
  tenantId     String
  federalState FederalState
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  name         String // z.B. "Frühjahrsferien", "Sommerferien"
  source       String // "OPENHOLIDAYS_API" | "MANUAL"
  externalId   String? // OpenHolidays UUID für Dedupe
  fetchedAt    DateTime     @db.Timestamptz
  createdAt    DateTime     @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, federalState, startDate, endDate, source])
  @@index([tenantId, federalState, startDate])
}

// ─────────────────────────────────────────────
// AUDIT LOG (DSGVO)
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // CREATE, UPDATE, DELETE, LOGIN, EXPORT, ANONYMIZE (per-employee DSGVO), ANONYMIZATION_RUN (batch sweep), BACKFILL_REVALIDATE
  entity    String // "TimeEntry", "LeaveRequest", etc.
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  purgeable Boolean  @default(false) // DSGVO Art. 5(1)(e): presence-only events (no stamp created) auto-purge after 90 days
  createdAt DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([purgeable])
  @@index([action])
}

// ─────────────────────────────────────────────
// NFC TERMINAL API KEYS
// ─────────────────────────────────────────────

model TerminalApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// WIFI PRESENCE SOURCES (Adapter-Auth-Keys)
// ─────────────────────────────────────────────

model PresenceSource {
  id            String    @id @default(uuid())
  tenantId      String
  name          String // Human-readable label (e.g. "Büro FritzBox")
  keyHash       String    @unique // SHA-256 of the raw clk_ key (never stored in plaintext)
  keyPrefix     String // First 8 chars of raw key for UI display (e.g. "clk_ab12")
  adapterUrl    String? // URL of the FritzBox adapter's /devices endpoint (proxied by admin UI)
  adapterSecret String? // Bearer token the API sends to the adapter's /devices endpoint (CR-02)
  isActive      Boolean   @default(true) // Admin can disable without deleting (PATCH endpoint)
  lastUsedAt    DateTime? @db.Timestamptz // Updated on every successful webhook auth (adapter health signal)
  revokedAt     DateTime? @db.Timestamptz // Soft-revoke; null = active
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz // Soft-delete (audit-proof: never hard-delete)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

// ─────────────────────────────────────────────
// WIFI PRESENCE DEVICES (MAC→Employee mapping)
// ─────────────────────────────────────────────

model PresenceDevice {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  mac           String // Normalized lowercase colon-separated: "aa:bb:cc:dd:ee:ff"
  label         String? // Optional human-readable label (e.g. "iPhone the operator", "Tablet")
  addedByUserId String? // userId of the person who created the mapping (null = system)
  addedAt       DateTime @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, mac]) // One MAC maps to exactly one employee per tenant
  @@index([tenantId])
  @@index([employeeId])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  keyPrefix  String // e.g. "clk_abc1" (shown in UI)
  scopes     String[] // e.g. ["read:employees", "read:time-entries", "read:reports"]
  expiresAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  createdBy  String // userId who created this key
  createdAt  DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

