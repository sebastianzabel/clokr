  WORK
  OVERTIME
  PUBLIC_HOLIDAY
}

enum TimeEntrySource {
  NFC
  MOBILE
  MANUAL
  CORRECTION
  WIFI
}

// Phase 91 (BREAK-01) — proves the auto-inserted break was actually taken.
// Legal: BAG 12.02.2025, 5 AZR 51/24; ArbZG §4 employer duty.
enum BreakStatus {
  AUTO
  CONFIRMED
  WAIVED
}

enum OvertimeTransactionType {
  ACCRUAL // Überstunden angesammelt (Monatsabschluss)
  REDUCTION // Abbau (Freizeit genommen)
  PAYOUT // Ausbezahlt
  CORRECTION // Manuelle Korrektur
}

enum OvertimePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CANCELLATION_REQUESTED
}

// Phase 76.29 — retro self-service approval flow status
enum RetroEntryStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

enum AbsenceType {
  SICK // Krankheit
  SICK_CHILD // Kindkrank
  SPECIAL_LEAVE // Sonderurlaub
  UNPAID_LEAVE // Unbezahlter Urlaub
  MATERNITY // Mutterschutz
  PARENTAL // Elternzeit
  OTHER
  VOCATIONAL_SCHOOL // Berufsschule (BBiG § 15/§ 17)
}

// Phase 63 (D-22): origin of an Absence row.
// PATTERN = auto-generated by the Phase 62 vocational-school cron (or future pattern engines).
// MANUAL  = human-created (leave flow, admin UI, D-23 manual-insert endpoint, etc.).
enum AbsenceSource {
  PATTERN
  MANUAL
}

// Phase 85 (SS-03): origin of a Shift row.
// MANUAL  = human-created (Schichtplanung UI, pattern generator) — NEVER touched by the Phorest sync.
// PHOREST = imported from Phorest via syncPhorestShifts(). Only PHOREST rows are upserted/soft-cancelled.
// Mirrors the AbsenceSource / TimeEntrySource convention. @default(MANUAL) backfills existing rows at
// ADD COLUMN time — no data migration.
enum ShiftOrigin {
  MANUAL
  PHOREST
}

// Phase 85 (SS-01): explicit Phorest staffId → clokr employee mapping.
// Replaces the fragile implicit name/email match in the sync path. Survives renames,
// multi-tenant-safe (@@unique([tenantId, phorestStaffId])), auditable. The name/email
// matcher is demoted to an advisory UI auto-suggest only (later plans).
model PhorestStaffMapping {
  id             String   @id @default(uuid())
  tenantId       String
  phorestStaffId String
  employeeId     String
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Audit-proof: never cascade-delete employee history (CLAUDE.md CASCADE=Restrict rule).
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, phorestStaffId])
  @@index([tenantId])
  @@index([employeeId])
}

// Phase 85 (SS-05): one row per sync invocation for observability/history.
// status: "RUNNING" → "SUCCESS" | "ERROR". Latest run surfaced prominently in the admin UI.
model PhorestSyncRun {
  id                      String    @id @default(uuid())
  tenantId                String
  startedAt               DateTime  @default(now()) @db.Timestamptz
  finishedAt              DateTime? @db.Timestamptz
  status                  String // "RUNNING" | "SUCCESS" | "ERROR"
  created                 Int       @default(0)
  updated                 Int       @default(0)
  cancelled               Int       @default(0)
  unmapped                Int       @default(0)
  // Phase 85.1 (D-08): shifts skipped by BS-wins (VOCATIONAL_SCHOOL Absence collision)
  skippedVocationalSchool Int       @default(0)
  // Phase 85.1 (D-08): shifts soft-deleted by D-11 Phorest-master replace
  replaced                Int       @default(0)
  error                   String?
  // Phase 86 (SA-03): appointment counters land on the SAME run row as the shift sync.
  // status/error above stay shift-owned; appointmentError records an appointment-fetch failure independently.
  appointmentsStored      Int       @default(0)
  appointmentsRemoved     Int       @default(0)
  appointmentError        String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
}

// Phase 86 (SA-01/SA-02) — DSGVO-minimal appointment busy-window cache.
// Read-only mirror of Phorest customer appointments, reduced to a bare busy window per mapped
// staff. This is a TRANSIENT external cache (not clokr audit data), so it is hard-replaced per
// sync window — no soft-delete. Tenant-scoped via the employee relation (like Shift, no tenantId).
//
// CRITICAL (SA-02): this model has NO customer/service/price columns. The DSGVO minimization is
// enforced structurally by the ABSENCE of those columns plus the closed mapAppointment() literal
// in services/phorest/sync-appointments.ts — the raw Phorest payload is never spread into a row.
model PhorestAppointment {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @db.Date // UTC midnight, tenant-local calendar day
  startTime  String // "HH:mm" busy-window start
  endTime    String // "HH:mm" busy-window end
  // Non-load-bearing idempotency/debug key (phorestAppointmentKey). GLOBALLY unique like Shift.externalId.
  // With hard-replace this is a nice-to-have, not the reconcile key.
  externalId String?  @unique
  createdAt  DateTime @default(now()) @db.Timestamptz

  // Audit-proof: never cascade-delete employee history (CLAUDE.md CASCADE=Restrict rule).
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Phase 87 overlap query: appointments of an employee within a date window.
  @@index([employeeId, date])
  @@index([date])
}

enum ScheduleType {
  FIXED_SCHEDULE // Fester Stundenplan (was FIXED_WEEKLY) — per-day Decimal hours configured
  FLEXTIME // Gleitzeit — Wochenstundensoll, freie Tagesverteilung; optional Kernarbeitszeit
  MONTHLY_HOURS // Monatsstunden-Budget (z.B. 15h/Monat für Minijobber)
  SHIFT_BASED // Schichtplan ist führend, weeklyHours als Wochen-Soll-Target (Phase 45)
}

// Personalstruktur-Kategorie (Phase 41) — used by Coverage-Gewicht & Aufsichtspflicht logic
// in v1.6 Schicht-Phasen and v1.7+ classification-based workflows.
enum EmployeeClassification {
  VOLLZEIT
  TEILZEIT
  MINIJOB
  AZUBI
  AUSHILFE
  WERKSTUDENT
  PRAKTIKANT
}

// ─────────────────────────────────────────────
// BETRIEBSURLAUB
// ─────────────────────────────────────────────

model CompanyShutdown {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String // z.B. "Weihnachtsschließung 2025"
  startDate           DateTime @db.Date
  endDate             DateTime @db.Date
  deductsFromVacation Boolean  @default(true) // zieht vom Urlaubskonto ab
  notes               String?
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exceptions CompanyShutdownException[]

  @@index([tenantId])
  @@index([tenantId, startDate])
}

/// Mitarbeiter, die vom Betriebsurlaub AUSGENOMMEN sind
model CompanyShutdownException {
  id         String   @id @default(uuid())
  shutdownId String
  employeeId String
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  shutdown CompanyShutdown @relation(fields: [shutdownId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shutdownId, employeeId])
}

// ─────────────────────────────────────────────
// BENACHRICHTIGUNGEN
// ─────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // LEAVE_REQUEST, LEAVE_APPROVED, LEAVE_REJECTED, OVERTIME_WARNING, MISSING_ENTRY, CLOCK_OUT_REMINDER, MONTH_CLOSED, ACCOUNT_LOCKED
  title       String
  message     String
  link        String? // e.g. "/leave" or "/admin/vacation"
  read        Boolean   @default(false)
  dismissedAt DateTime? @db.Timestamptz // null = visible; set = soft-dismissed (Revisionssicherheit: row kept)
  relatedType String? // e.g. "LeaveRequest", "TimeEntry" — loose reference, no FK
  relatedId   String? // id of the related entity (used by dismissByRelated helper)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([userId, dismissedAt])
  @@index([relatedType, relatedId])
}

// ─────────────────────────────────────────────
// SCHICHTPLANUNG
// ─────────────────────────────────────────────

model ShiftTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Frühschicht", "Spätschicht", "Nachtschicht"
  startTime String // "06:00"
  endTime   String // "14:00"
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now()) @db.Timestamptz

  shifts        Shift[]
  coverageRules CoverageRule[]
  shiftPatterns EmployeeShiftPattern[]

  @@index([tenantId])
}

// Phase 42 — Bedarfsregeln pro Vorlage × Wochentag.
// Most-specific match wins when computing coverage:
//   (templateId set AND dayOfWeek set) > (templateId null AND dayOfWeek set) >
//   (templateId set AND dayOfWeek=-1) > (templateId null AND dayOfWeek=-1)
// Default (no rule): minStaff=2.0, requiresNonSupervised=false.
model CoverageRule {
  id                    String         @id @default(uuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId            String?
  template              ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOfWeek             Int // 0=Mo..6=So; -1 = "all days"
  minStaff              Decimal        @default(2) @db.Decimal(4, 2)
  requiresNonSupervised Boolean        @default(false)
  createdAt             DateTime       @default(now()) @db.Timestamptz
  updatedAt             DateTime       @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@index([templateId])
}

model Shift {
  id                 String         @id @default(uuid())
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId         String?
  template           ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date               DateTime       @db.Date
  startTime          String // "06:00"
  endTime            String // "14:00"
  label              String? // Custom label or template name
  note               String?
  // Phase 43: marked TRUE by reverse-hook when a LeaveRequest is approved
  // that overlaps this shift's date. Audit-proof: shift is flagged, never silent-deleted.
  conflictsWithLeave Boolean        @default(false)
  // Phase 85 (SS-03/SS-07): shift provenance + Phorest idempotency key.
  // origin defaults to MANUAL so all existing rows backfill to MANUAL at ADD COLUMN time (no data migration).
  // externalId is the stable Phorest key (phorestShiftKey); GLOBALLY unique — Phorest ids are opaque UUIDs,
  // so cross-tenant collision is negligible. Tenant isolation for reconcile/write is enforced by the
  // origin=PHOREST + employee.tenantId filter on every sync query, NOT by this column. MANUAL shifts leave it null.
  origin             ShiftOrigin    @default(MANUAL)
  externalId         String?        @unique
  createdAt          DateTime       @default(now()) @db.Timestamptz
  createdBy          String?
  // Phase 67.2 — Soft-Delete (additive only, audit-proof).
  // Set when an Auto-Cleanup-Hook removes a Shift on einem neu entstandenen Berufsschultag.
  // Vergangenheits-Shifts (date < today) werden NIE soft-deleted — nur conflictsWithLeave=true gesetzt.
  // Restore-Pfad via /shifts/conflicts UI mit explicit Manager-Aktion + AuditLog.
  // Phase 85 (SS-04): also set on Phorest windowed soft-cancel with deletedReason = "PHOREST_REMOVED".
  deletedAt          DateTime?      @db.Timestamptz
  deletedReason      String? // z.B. "AUTO_BS_DAY_CLEANUP", "MANUAL_RESTORE_REVERT", "PHOREST_REMOVED"

  @@index([employeeId, date])
  @@index([date])
  @@index([employeeId, date, deletedAt])
  // Phase 85 — supports the windowed reconcile query (origin=PHOREST, date in window).
  @@index([origin, date])
}

// Phase 43 — Recurring weekly shift assignments per employee.
// One row per (employee, dayOfWeek, validFrom): the active pattern is the one
// whose validFrom <= date AND (validUntil IS NULL OR validUntil >= date) AND isActive.
// templateId NULL = "leave the day open" (e.g. day off). With templateId = use this
// template on this weekday. POST /shifts/generate-week reads these and produces shifts.
model EmployeeShiftPattern {
  id         String         @id @default(uuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Mo..6=So
  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  validFrom  DateTime       @db.Date
  validUntil DateTime?      @db.Date // null = open-ended
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz

  @@unique([employeeId, dayOfWeek, validFrom])
  @@index([employeeId])
}

// Phase 62 — Recurring vocational-school day pattern per employee.
// Either daysOfWeek (regular weekdays) OR blockWeeks (ISO weeks of a year) must be set.
// Enforced application-side via Zod refine in routes/vocational-school-pattern.ts.
// The auto-generator (plugins/vocational-school-generator.ts) reads these and produces
// Absence rows of type VOCATIONAL_SCHOOL for the next TenantConfig.vocationalSchoolPreviewWeeks weeks.
//
// Phase 67.1 (v1.7.4) — Multi-day support: `daysOfWeek Int[]` replaces single-value
// `dayOfWeek Int?`. The legacy `dayOfWeek` column is retained for one release of soak
// (drop scheduled for v1.7.5) so downgrade is possible. New code MUST read/write
// `daysOfWeek`; the API normalises legacy inbound `dayOfWeek` into the array form.
model EmployeeVocationalSchoolPattern {
  id                         String        @id @default(uuid())
  employeeId                 String
  employee                   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek                  Int? // DEPRECATED v1.7.4 — kept for one release of soak, drop in v1.7.5
  daysOfWeek                 Int[]         @default([]) // 0=Mo..6=So for recurring weekdays; empty array when only blockWeeks set
  blockWeeks                 Int[] // ISO week numbers for block-school weeks; empty array when only daysOfWeek set
  blockYear                  Int? // Year context for blockWeeks (for annual uniqueness); null when only daysOfWeek set
  validFrom                  DateTime      @db.Date
  validUntil                 DateTime?     @db.Date // null = open-ended
  isActive                   Boolean       @default(true)
  // Phase 67.2 — Schulferien-Integration. Default TRUE für IHK-Berufe (KMK-Ferien).
  // Opt-OUT für Pflegeschulen / Berufsakademien die eigenem Schuljahresplan folgen.
  respectSchoolHolidays      Boolean       @default(true)
  // Phase 67.2 — Pendler-Azubi-Support: BS in anderem Bundesland als Betrieb.
  // NULL = verwende Tenant.federalState (Default).
  federalStateOverride       FederalState?
  // Phase 76.31 — BVaDiG-2024 slot-aware BS crediting (D-06 per-pattern layer).
  // NULL = delegate to TenantConfig.
  bsSlotFirstLongDayMinutes  Int?
  bsSlotSecondLongDayMinutes Int?
  bsSlotShortDayMinutes      Int?
  bsSlotBlockWeekMinutes     Int?
  // Phase 76.38 — Duration-based BS slot classification (§15 Abs. 2 Nr. 2 BBiG).
  // JSON map from DOW int (0=Mo..6=So) to Unterrichtsminuten Int.
  // e.g. {"1": 300, "4": 180} = Tuesday 300 min, Friday 180 min.
  // Empty object {} = not captured → ordinal fallback (backward compat).
  // Individual entry >225 min = Langtag; ≤225 min = Kurztag.
  unterrichtsMinutenByDow    Json          @default("{}")
  createdAt                  DateTime      @default(now()) @db.Timestamptz
  updatedAt                  DateTime      @updatedAt @db.Timestamptz

  @@index([employeeId, isActive])
}

// Phase 46 — Employee availability declaration (recurring weekly OR one-off date).
// Resolution priority on GET /shifts/week: APPROVED LeaveRequest > non-deleted Absence >
// date-specific EmployeeAvailability > dayOfWeek-recurring EmployeeAvailability > AVAILABLE.
// XOR: EXACTLY ONE of dayOfWeek / date must be set (enforced in Zod app-layer).
// No deletedAt — operational future-intent data; audit-log records DELETE.
model EmployeeAvailability {
  id         String             @id @default(uuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int? // 0=Mo..6=So; null for one-off date entries
  date       DateTime?          @db.Date // null for recurring; set for one-off
  status     AvailabilityStatus
  note       String?            @db.VarChar(200)
  validFrom  DateTime           @db.Date
  validUntil DateTime?          @db.Date // null = open-ended
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz
  createdBy  String?

  @@index([employeeId])
  @@index([employeeId, dayOfWeek])
  @@index([employeeId, date])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}
