{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false
  },
  "include": [
    "src/seed.ts",
    "src/seed-credentials.ts",
    "src/default-salon.ts",
    "generated/**/*.d.ts"
  ]
}
