{
  "name": "@clokr/web",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:tokens": "! grep -rE 'var\\(--(color-|glass-|radius-|gray-)' src/ || (echo 'ERROR: legacy v1.2 token reference found. See apps/web/.lintrc-tokens.txt for replacements.' && exit 1)",
    "lint:ui": "node scripts/lint-ui.mjs",
    "lint:ui-classes": "node scripts/lint-ui-classes.mjs",
    "lint:save-pattern": "node scripts/lint-save-pattern.mjs",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clokr/types": "workspace:*",
    "@tanstack/svelte-query": "^6.1.38",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "svelte-dnd-action": "^0.9.79"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
