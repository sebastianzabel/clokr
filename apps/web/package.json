    "lint:ui": "node scripts/lint-ui.mjs",
    "lint:ui-classes": "node scripts/lint-ui-classes.mjs",
    "typecheck": "svelte-kit sync && tsc --noEmit"
  },
  "dependencies": {
    "@clokr/types": "workspace:*",
    "@tanstack/svelte-query": "^6.1.29",
    "chart.js": "^4.5.1",
    "date-fns": "^4.2.0",
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
