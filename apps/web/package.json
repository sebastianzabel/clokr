{
  "name": "@clokr/web",
  "version": "1.8.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:tokens": "! grep -rE 'var\\(--(color-|glass-|radius-|gray-)' src/ || (echo 'ERROR: legacy v1.2 token reference found. See apps/web/.lintrc-tokens.txt for replacements.' && exit 1)",
    "lint:ui": "node scripts/lint-ui.mjs",
    "lint:ui-classes": "node scripts/lint-ui-classes.mjs",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clokr/types": "workspace:*",
    "@tanstack/svelte-query": "^6.1.29",
    "chart.js": "^4.5.1",
    "date-fns": "^4.2.0",
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.14",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
