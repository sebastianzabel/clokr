{
  "name": "@clokr/api",
  "version": "1.9.18",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:setup": "sh -c 'CALLER_NODE_ENV=\"${NODE_ENV-}\"; set -a; . ./.env.test; set +a; if [ -n \"$CALLER_NODE_ENV\" ]; then NODE_ENV=\"$CALLER_NODE_ENV\"; export NODE_ENV; fi; tsx scripts/ensure-test-database.ts && DATABASE_URL=$TEST_DATABASE_URL pnpm --filter @clokr/db exec prisma migrate deploy && tsx scripts/reset-test-databases.ts'",
    "pretest": "pnpm run test:setup",
    "pretest:coverage": "pnpm run test:setup",
    "pretest:watch": "pnpm run test:setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clokr/db": "workspace:*",
    "@clokr/types": "workspace:*",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "date-fns-tz": "^3.2.0",
    "fastify": "^5.8.5",
    "iconv-lite": "^0.7.3",
    "minio": "^8.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
