# Copy to sim.env (git-ignored) and fill in. Generate every secret value with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
OPERATOR_JWT_SECRET=
ENCRYPTION_KEY=
MINIO_ROOT_USER=sim-minio
MINIO_ROOT_PASSWORD=

# The release the instance runs. Use the image of the release under test.
CLOKR_API_IMAGE=ghcr.io/sebastianzabel/clokr-api:1.17.0
CLOKR_WEB_IMAGE=ghcr.io/sebastianzabel/clokr-web:1.17.0

# Host ports (all bound to 127.0.0.1). Never 3000/4000/3001/4001/5432/5433.
SIM_API_PORT=14100
SIM_WEB_PORT=13100
SIM_PG_PORT=15532
SIM_MAIL_PORT=18125

# Public URL of the web app as users see it (invitation links, CORS).
APP_URL=http://127.0.0.1:13100
CORS_ORIGIN=http://127.0.0.1:13100

# Edge profile only (server install): Basic-Auth user and the output of `caddy hash-password`.
# SIM_EDGE_BIND defaults to loopback; set the host's private interface address on a server.
# SIM_EDGE_USER=
# SIM_EDGE_HASH=
# SIM_EDGE_BIND=127.0.0.1
# SIM_EDGE_PORT=18180

# Bot and checker side (read by `pnpm --filter @clokr/sim sim ...`).
SIM_API_URL=http://127.0.0.1:14100
SIM_SEED=clokr-sim-1
# Read-only checker connection (role created by `sim.sh ro-role`).
SIM_DB_URL=postgresql://clokr_sim_ro:CHANGE_ME@127.0.0.1:15532/clokr
