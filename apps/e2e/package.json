{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=desktop-chrome",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:audit": "playwright test tests/ui-audit.spec.ts tests/accessibility.spec.ts",
    "lint": "eslint . --max-warnings=0",
    "report": "playwright show-report",
    "stack:up": "docker compose -f ../../docker-compose.test.yml up --wait",
    "stack:down": "docker compose -f ../../docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0"
  }
}
