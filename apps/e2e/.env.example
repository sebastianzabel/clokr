# Copy to .env and adjust for your local environment.
# Playwright loads this file automatically (see playwright.config.ts).

# ── Stack URL ─────────────────────────────────────────────────────────────────
# Base URL used by the test runner. Defaults to http://localhost:3001
# (the web-test service in docker-compose.test.yml).
# Set to http://localhost:3000 + WEB_SERVER_DISABLED=true to point at the dev stack.
# PLAYWRIGHT_BASE_URL=http://localhost:3001

# Legacy alias of PLAYWRIGHT_BASE_URL — kept for backwards compatibility.
# BASE_URL=http://localhost:3001

# ── Tenant fixture (Plan 73-02) ───────────────────────────────────────────────
# Where the tenant fixture sends bootstrap + teardown requests.
# Defaults to http://localhost:4000 (dev API). Set to :4001 when using docker-compose.test.yml.
# E2E_API_BASE=http://localhost:4001

# Set to "true" to skip tenant teardown — useful for debugging a failing test.
# KEEP_TEST_TENANTS=true

# ── Auth seed admin (auth.setup.ts) ───────────────────────────────────────────
# Used by the setup project to log in and persist storageState.
TEST_ADMIN_EMAIL=admin@clokr.de
TEST_ADMIN_PASSWORD=YourAdminPassword

# ── Runner overrides ──────────────────────────────────────────────────────────
# Skip the docker-compose webServer block (talk to an already-running stack).
# WEB_SERVER_DISABLED=true

# Force a specific worker count (overrides CI?4:cpu/2).
# PLAYWRIGHT_WORKERS=2

# Set to "true" by Playwright in CI mode automatically — also bumps workers to 4
# and toggles forbidOnly + retry behavior.
# CI=true
