# Phase 75 — Visual regression runner.
# Pinned to mcr.microsoft.com/playwright:v1.60.0-jammy so font rendering
# (Liberation Sans, DejaVu, Noto) is byte-identical on macOS dev, Linux dev,
# and GitHub Actions runners. The tag MUST match the `@playwright/test`
# version pinned in apps/e2e/package.json — bumping the npm dep without
# bumping the image tag (or vice versa) produces "Executable doesn't exist"
# launch errors. Plan 75-02 bumped 1.58.2 → 1.60.0 to track the npm dep
# that landed during Phase 70-06 / 73 chains; baselines are first-run on
# 1.60.0 so no historical drift to reconcile.
# DO NOT bump the tag without re-baselining all screenshots in
# apps/e2e/tests/visual.spec.ts-snapshots/.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

# pnpm — match repo lockfile version (10.33.0)
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /work

# We do NOT copy package.json here; the repo is bind-mounted by docker-compose.e2e.yml.
# This keeps the image cache stable across dependency changes — pnpm install runs at
# container start against the mounted node_modules.
#
# Pre-create node_modules mount points and chown to pwuser so the anonymous volumes
# declared in docker-compose.e2e.yml (which shadow the host's node_modules to keep
# linux-vs-macOS binaries from leaking in) inherit pwuser ownership. Without this,
# anonymous volumes are created root-owned and `pnpm install` inside the container
# fails with EACCES.
RUN mkdir -p /work/node_modules /work/apps/e2e/node_modules \
 && chown -R pwuser:pwuser /work

# Run as the playwright user that ships with the base image (non-root).
USER pwuser

# Default command — overridden by docker-compose.
CMD ["pnpm", "--filter", "e2e", "exec", "playwright", "test", "--project=visual"]
